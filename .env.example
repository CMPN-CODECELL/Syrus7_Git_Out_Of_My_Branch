# AI Trading Copilot Environment Configuration Template
# Copy this file to .env and replace placeholder values.

# Application
APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Server / Ingestion Auth
INTERNAL_API_KEY=your-internal-api-key-here

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Database (PostgreSQL / TimescaleDB)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/NexusQuantDB
DB_USER=postgres
DB_PASSWORD=postgres

# Market Data Provider (groww or nse)
MARKET_DATA_PROVIDER=nse
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_ACCESS_TOKEN=
GROWW_TOTP_SECRET=
GROWW_PIN=

# Supabase (Auth / Client)
supabaseUrl=https://your-project.supabase.co
supabaseKey=your-supabase-anon-publishable-key
supabaseConnectionString=

# Ingestion Settings
WATCHLIST_SYMBOLS=NIFTY,BANKNIFTY,FINNIFTY,RELIANCE,TCS,INFY,HDFCBANK
PRICE_POLL_INTERVAL_SECONDS=5
OPTIONS_POLL_INTERVAL_SECONDS=15

# Macro Defaults
DEFAULT_RISK_FREE_RATE_INR=6.5
DEFAULT_RISK_FREE_RATE_USD=5.25
