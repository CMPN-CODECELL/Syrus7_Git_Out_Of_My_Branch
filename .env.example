# Kraken environment template. Copy to .env and fill in real values.
# .env is gitignored. Never commit real credentials.

# Application
APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Internal service key for /v1/ingestion/* routes
INTERNAL_API_KEY=change-me-long-random-string

# Redis (in-container, password protected)
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@localhost:6379/0

# PostgreSQL / TimescaleDB (in-container)
DB_USER=kraken
DB_PASSWORD=change-me-db-password
DATABASE_URL=postgresql://kraken:change-me-db-password@localhost:5432/NexusQuantDB

# Analysis data provider (yfinance + NSE scraper)
MARKET_DATA_PROVIDER=nse

# Supabase (app login). supabaseKey must be the ANON key; never the service-role key.
supabaseUrl=https://your-project.supabase.co
supabaseKey=your-supabase-anon-key
supabaseConnectionString=
# Legacy HS256 JWT secret (Project Settings > API). Leave empty to verify via the project's JWKS instead.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# 021 Trade broker. Username is your UCC (HACK....), not your email.
# One live token per account: running two copies of Kraken (or a script) with the same UCC revokes the other's token.
TRADE_API_BASE_URL=https://devapi.021.trade/api/developer-api/v1
TRADE_WS_BASE_URL=wss://devapi.021.trade/api/developer/websocket
TRADE_API_USERNAME=
TRADE_API_PASSWORD=
TRADE_API_TIMEOUT_SECONDS=10
TRADE_API_RATE_PER_SECOND=5
TRADE_API_MAX_GET_RETRIES=3
INSTRUMENTS_CACHE_PATH=data/instruments.csv.gz

# Order safety limits (paise; Rs 1 = 100 paise)
TRADING_KILL_SWITCH=false
MAX_ORDER_VALUE_PAISE=20000000
MAX_ORDER_QTY=5000
ALLOWED_EXCHANGES=NSE,NSEFO
ALLOWED_PRODUCTS=CNC,INTRADAY,NRML

# LLM (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CHAT_MAX_MESSAGE_CHARS=1000
CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_MAX_TOOL_CALLS=6

# Analysis ingestion
WATCHLIST_SYMBOLS=NIFTY,BANKNIFTY
PRICE_POLL_INTERVAL_SECONDS=5
OPTIONS_POLL_INTERVAL_SECONDS=15
BACKFILL_DAYS=400

# Option-chain side panel defaults
DEFAULT_RISK_FREE_RATE_INR=6.5
DEFAULT_RISK_FREE_RATE_USD=5.25
